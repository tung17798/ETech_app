{
  "name": "ETech",
  "slug": "etech_app",
  "scheme": "etech_app",
  "version": "1.0.0",
  "orientation": "portrait",
  "userInterfaceStyle": "automatic",
  "icon": "./assets/images/logo-icon.jpg",
  "updates": {
    "fallbackToCacheTimeout": 0
  },
  "newArchEnabled": true,
  "jsEngine": "hermes",
  "assetBundlePatterns": [
    "**/*"
  ],
  "android": {
    "icon": "./assets/images/logo-icon.jpg",
    "package": "com.etechsolution.etech",
    "adaptiveIcon": {
      "foregroundImage": "./assets/images/logo-icon.jpg",
      "backgroundImage": "./assets/images/logo-icon.jpg"
    },
    "allowBackup": false,
    "edgeToEdgeEnabled": true
  },
  "ios": {
    "icon": "./assets/images/logo-icon.jpg",
    "supportsTablet": true,
    "bundleIdentifier": "com.etechsolution.etech"
  },
  "web": {
    "favicon": "./assets/images/app-icon-web-favicon.png",
    "bundler": "metro"
  },
  "plugins": [
    "expo-localization",
    "expo-font",
    [
      "expo-splash-screen",
      {
        "image": "./assets/images/logo-icon.jpg",
        "imageWidth": 300,
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF"
      }
    ],
    [
      "react-native-edge-to-edge",
      {
        "android": {
          "parentTheme": "Light",
          "enforceNavigationBarContrast": false
        }
      }
    ]
  ],
  "experiments": {
    "tsconfigPaths": true
  },
  "extra": {
    "ignite": {
      "version": "11.0.1"
    },
    "eas": {
      "projectId": "a5c17946-b879-44af-8b79-73c1d638b3bf"
    }
  }
}
